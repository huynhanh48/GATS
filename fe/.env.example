# GATS Academy — learner web (Vite SPA) env template.
#
# Docker dev: docker-compose.yml already injects PUBLIC_API_URL, so you only need
#             this file when running `cd fe && npm run dev` directly on the host.
#             Copy to .env.local (gitignored):
#               cp fe/.env.example fe/.env.local
#
# PUBLIC_* / BANK_* / SEPAY_* are inlined into the bundle (see envPrefix in
# fe/vite.config.js). In the production image they come from Docker build args,
# so changing them requires a rebuild.

# Backend API origin the browser calls (no trailing slash).
PUBLIC_API_URL=http://localhost:3000

# Google Sign-In client ID (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID of admin).
PUBLIC_GOOGLE_CLIENT_ID=

# Fallback bank account shown at checkout when the API returns none.
BANK_NAME=VietinBank
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
