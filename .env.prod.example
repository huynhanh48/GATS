# =============================================================================
# GATS Academy — ENV PRODUCTION (VPS)
# -----------------------------------------------------------------------------
# Đây là BẢN MẪU. Điền vào `.env` ở gốc repo rồi mới deploy:
#
#   cp .env.prod.example .env
#   $EDITOR .env                                     # điền các dòng ghi "← ĐIỀN"
#   docker compose -f docker-compose.prod.yml up -d --build
#   docker compose -f docker-compose.prod.yml logs -f app
#
# Quy ước trong file:
#   [BẮT BUỘC]  để trống → `docker compose` báo lỗi và dừng ngay (không build).
#   [NÊN ĐIỀN]  để trống vẫn chạy, nhưng mất chức năng tương ứng.
#   [TÙY CHỌN]  chỉ điền khi dùng.
#
# Ba lưu ý quan trọng:
#   1. KHÔNG commit `.env` (đã nằm trong .gitignore). Máy dev dùng `.env.example`.
#   2. `NEXT_PUBLIC_*` được nhúng vào JS của admin + fe LÚC BUILD. Sửa chúng thì
#      phải build lại:  docker compose -f docker-compose.prod.yml up -d --build
#      Các biến còn lại sửa xong chỉ cần: docker compose -f docker-compose.prod.yml up -d
#   3. Lần `up` đầu tiên, container `app` tự chạy migration + seed lõi
#      (roles, permissions, tài khoản ADMIN_DEFAULT_*, 6 nhóm khoá học chính)
#      rồi mới start be/worker/admin/fe bằng pm2. Migration/seed lỗi → container
#      thoát, không phục vụ traffic.
# =============================================================================

# -----------------------------------------------------------------------------
# CHECKLIST — 7 nhóm biến phải tự điền (chi tiết ở từng mục bên dưới)
# -----------------------------------------------------------------------------
#  1. POSTGRES_PASSWORD                       mật khẩu DB mới:   openssl rand -base64 24
#  2. JWT_SECRET                              chuỗi >= 32 ký tự: openssl rand -hex 32
#  3. EMAIL_USER + EMAIL_PASSWORD             Gmail + App Password 16 ký tự (bật 2FA)
#  4. MINIO_ROOT_USER + MINIO_ROOT_PASSWORD   tài khoản S3 nội bộ (tự đặt)
#  5. S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY LongVan, hoặc dùng lại giá trị MINIO_ROOT_*
#  6. ADMIN_DEFAULT_EMAIL + ADMIN_DEFAULT_PASSWORD   tài khoản admin tạo tự động
#  7. SEPAY_API_KEY                           API token my.sepay.vn
#
# Giá trị đã điền sẵn, chỉ sửa khi tên miền / ngân hàng đổi:
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID, NEXT_PUBLIC_API_URL, APP_URL, FRONTEND_URL,
#   MINIO_BUCKET_NAME, BANK_NAME, BANK_ACCOUNT_NUMBER, BANK_ACCOUNT_NAME.

# =============================================================================
# 1. TÊN MIỀN VÀ GOOGLE LOGIN
# =============================================================================
# --- Google Login [BẮT BUỘC nếu muốn đăng nhập Google] ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# 2) Authorized JavaScript origins phải chứa ĐÚNG URL người dùng mở:
#      https://gats.vn
#      https://www.gats.vn
#      https://admin.gats.vn
#      http://localhost:3002   (chỉ khi dev)
#    Mở http://IP:3002 hoặc host không có trong danh sách → nút Google lỗi trên máy khác.
# 3) Authorized redirect URIs (GIS popup): https://gats.vn  (và www nếu dùng)
# 4) Cùng Client ID cho cả bundle trình duyệt (fe + admin) và be verify token:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com

# Origin HTTPS mà TRÌNH DUYỆT dùng để gọi API (nhúng vào bundle lúc build).
# Sai giá trị này = fe/admin gọi sai API. [BẮT BUỘC]
NEXT_PUBLIC_API_URL=https://api.gats.vn
# URL công khai của API (be dùng để tạo link trong email/QR). [BẮT BUỘC]
APP_URL=https://api.gats.vn
# Danh sách origin được phép gọi API (CORS + cookie SSO), cách nhau bằng dấu phẩy.
# [BẮT BUỘC] Origin Google Console phải khớp scheme thật:
#   đang HTTP  → thêm http://gats.vn
#   đang HTTPS → thêm https://gats.vn
FRONTEND_URL=https://gats.vn,https://admin.gats.vn,http://localhost:3001,http://localhost:3002
# Domain cha cho cookie đăng nhập dùng chung giữa gats.vn và admin.gats.vn.
# Bỏ trống nếu fe và admin khác domain (không dùng SSO).
AUTH_COOKIE_DOMAIN=.gats.vn

# =============================================================================
# 2. DATABASE — Postgres chạy trong compose, KHÔNG mở cổng ra ngoài
# =============================================================================
POSTGRES_USER=postgres
# [BẮT BUỘC] mật khẩu mạnh:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=gats_academy
# Chỉ đặt khi DB đã có dữ liệu nhưng CHƯA có bảng `gats_schema_migrations`
# (DB dựng trước khi dùng migration versioned). Giá trị = tên thư mục migration
# cuối cùng đã có trong schema live, ví dụ: 20260901120000_add_xyz
# DB mới (trống) → để trống. Deploy xong lần đầu thì xoá dòng này.
MIGRATION_BASELINE_THROUGH=

# =============================================================================
# 3. SECRET CỦA ỨNG DỤNG
# =============================================================================
# [BẮT BUỘC] khoá ký JWT, tối thiểu 32 ký tự:  openssl rand -hex 32
# KHÔNG dùng giá trị mẫu — be từ chối khởi động ở production nếu thấy giá trị mặc định.
JWT_SECRET=

# --- Email (SMTP Gmail, be gửi mail xác thực/quên mật khẩu/thông báo lead) ---
# [BẮT BUỘC] EMAIL_USER = địa chỉ Gmail gửi đi
# [BẮT BUỘC] EMAIL_PASSWORD = App Password 16 ký tự
#   (Google Account → Security → 2-Step Verification → App passwords)
EMAIL_USER=
EMAIL_PASSWORD=
# [TÙY CHỌN] Hộp thư nhận thông báo "khách để lại thông tin tư vấn".
# Bỏ trống = gửi về chính EMAIL_USER.
LEAD_NOTIFY_EMAIL=

# =============================================================================
# 4. S3 NỘI BỘ (RustFS) — ảnh/file upload của media, avatar, tài liệu
# =============================================================================
# [BẮT BUỘC] tài khoản của RustFS trong compose (tự đặt, không phải tài khoản cloud).
# MINIO_ROOT_USER/PASSWORD cũng là credential của S3 nội bộ → phải khớp
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY nếu bạn giữ video trên S3 nội bộ.
MINIO_ROOT_USER=
# [BẮT BUỘC] mật khẩu mạnh, ví dụ:  openssl rand -base64 24
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=files-gats
# [BẮT BUỘC] Base HTTPS mà TRÌNH DUYỆT mở được cho media (nginx → s3:9000 /files-gats/).
# Không đặt → be lưu URL http://minio:9000/... và trình duyệt không mở được ảnh.
# Xem mục nginx trong README (location /files-gats/).
MINIO_PUBLIC_BASE_URL=https://api.gats.vn/files-gats
# MINIO_ENDPOINT mặc định http://s3:9000 (container s3 trong compose) — chỉ đổi
# khi tách S3 ra máy/dịch vụ khác.

# =============================================================================
# 5. VIDEO (HLS + transcode) — bucket riêng, KHÔNG dùng chung bucket ảnh
# =============================================================================
# Trình duyệt upload trực tiếp lên S3 bằng presigned URL. URL đó PHẢI là HTTPS,
# nếu không Chrome chặn mixed-content ("Failed to fetch") trên admin.gats.vn.
#
# Cách A — LongVan (khuyến nghị cho video prod): điền 3 dòng credential dưới đây.
S3_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_BUCKET=s3-video-gats
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_PUBLIC_BASE_URL=https://s3-hn1-r1.longvan.net/s3-video-gats
#
# Cách B — giữ video trên S3 nội bộ (RustFS) cho API, lộ host HTTPS công khai
# (nginx → s3:9000) và đặt:
#   S3_ENDPOINT=http://s3:9000
#   S3_BUCKET=s3-video-gats            (bucket được s3-init tạo tự động)
#   S3_ACCESS_KEY_ID=<MINIO_ROOT_USER>
#   S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
#   S3_PUBLIC_ENDPOINT=https://media.gats.vn
#   S3_PUBLIC_BASE_URL=https://media.gats.vn/s3-video-gats

# =============================================================================
# 6. TÀI KHOẢN ADMIN ĐẦU TIÊN
# =============================================================================
# [BẮT BUỘC] Container `app` tự tạo admin này ở lần deploy đầu (seed lõi, idempotent:
# lần sau chỉ chạy lại roles/permissions, không ghi đè mật khẩu).
# Đổi mật khẩu ngay sau lần đăng nhập đầu tiên. KHÔNG dùng giá trị mặc định của dev.
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# =============================================================================
# 7. THANH TOÁN
# =============================================================================
# --- SePay (mặc định: VietQR + webhook ngân hàng) ---
# [BẮT BUỘC] API token my.sepay.vn (SePay → API/Integrations → API token)
SEPAY_API_KEY=
# Webhook URL khai báo trên SePay (Integrations → Webhooks):
#   https://api.gats.vn/api/payment/sepay/webhook
# Auth: API Key = SEPAY_API_KEY, loại GD: Tiền vào, JSON, bật retry.
# Nếu tên miền khác api.gats.vn → sửa lại cho đúng.

# --- SePay Payment Gateway (tùy chọn — chỉ bật khi đã có merchant) ---
SEPAY_PG_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_PG_ENV=production
# FRONTEND_URL nên để learner site trước, ví dụ:
# FRONTEND_URL=https://gats.vn,https://admin.gats.vn

# --- STK fallback khi DB chưa có bank account ---
# [NÊN ĐIỀN] Đồng thời được nhúng vào bundle fe lúc build (fe đọc BANK_* →
# hiển thị ở modal thanh toán khi API không trả về) → sửa phải build lại.
BANK_ACCOUNT_NUMBER=107877010522
BANK_NAME=VietinBank
BANK_ACCOUNT_NAME=VOVANHUYNHANH

# --- VNPay (chỉ cần nếu bật cổng VNPay; checkout chính hiện là bank_transfer) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=

# --- Thông tin người bán in trên biên lai thanh toán [TÙY CHỌN] ---
# Bỏ trống = dùng giá trị mặc định trong be (GATS Academy, địa chỉ Hà Nội).
SELLER_NAME=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_TAX_CODE=

# =============================================================================
# 8. TÙY CHỌN KHÁC — để trống là tắt, app vẫn chạy bình thường
# =============================================================================
# --- FCM push (thông báo thiết bị) ---
# FCM_SERVICE_ACCOUNT_JSON phải là JSON MỘT DÒNG (hoặc escape đúng trong .env).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
# --- Apple Sign In (Services ID / Bundle ID dùng làm JWT audience) ---
APPLE_CLIENT_ID=
# --- Nâng/hạ tải video worker (mặc định trong compose là 1 / 16 / veryfast) ---
# VIDEO_WORKER_CONCURRENCY=1
# HLS_UPLOAD_CONCURRENCY=16
# FFMPEG_X264_PRESET=veryfast
