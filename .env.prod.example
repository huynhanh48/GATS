# GATS Academy — env cho PRODUCTION (VPS). Copy thành `.env` ở gốc repo:
#   cp .env.prod.example .env
# rồi deploy:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# KHÔNG dùng file này cho máy dev — dùng `.env.example` (API trỏ localhost).
#
# NEXT_PUBLIC_* được nhúng vào JS của fe lúc BUILD.
# Đổi các biến này phải build lại: `docker compose build --no-cache` (hoặc up --build).
# BE_API_URL trong container luôn là http://localhost:3000 (đặt sẵn trong compose).

# --- Google Login (bắt buộc cho Docker + thiết bị khác) ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# 2) Authorized JavaScript origins phải chứa đúng URL người dùng mở:
#      https://gats.vn
#      https://www.gats.vn
#      http://localhost:3002   (chỉ khi dev)
#    Mở http://IP:3005 hoặc host không có trong danh sách → nút Google lỗi trên máy khác.
# 3) Authorized redirect URIs (GIS popup): https://gats.vn  (và www nếu dùng)
# 4) Cùng Client ID cho cả bundle trình duyệt và be verify token:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com

NEXT_PUBLIC_API_URL=https://api.gats.vn
APP_URL=https://api.gats.vn
# Chỉ gats.vn (không dùng www). Origin Google Console phải khớp scheme thật:
#   đang HTTP  → thêm http://gats.vn
#   đang HTTPS → thêm https://gats.vn
FRONTEND_URL=https://gats.vn,https://admin.gats.vn,http://localhost:3001,http://localhost:3002

# --- Secret production bắt buộc (tự sinh giá trị riêng; KHÔNG commit .env) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gats_academy
JWT_SECRET=
AUTH_COOKIE_DOMAIN=.gats.vn
EMAIL_USER=
EMAIL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=files-gats
# Base HTTPS mà trình duyệt mở được cho media (nginx → minio:9000 /files-gats/).
# Không đặt → be lưu http://minio:9000/... và trình duyệt không mở được.
MINIO_PUBLIC_BASE_URL=https://api.gats.vn/files-gats
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
# Chỉ khi DB đã tồn tại: đặt bằng baseline mà schema live đang có.
# Để trống với DB mới; xoá sau lần deploy thành công đầu tiên.
MIGRATION_BASELINE_THROUGH=

# --- Video storage (bắt buộc để admin upload qua HTTPS) ---
# Trình duyệt upload trực tiếp lên S3 bằng presigned URL. URL đó PHẢI là HTTPS,
# nếu không Chrome chặn mixed-content ("Failed to fetch") trên admin.gats.vn.
#
# Cách A — LongVan (khuyến nghị cho video prod):
S3_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_BUCKET=s3-video-gats
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_PUBLIC_BASE_URL=https://s3-hn1-r1.longvan.net/s3-video-gats
#
# Cách B — giữ MinIO trong cluster cho API, nhưng lộ host HTTPS công khai
# (nginx → minio:9000) và đặt:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_ENDPOINT=https://media.gats.vn
#   S3_PUBLIC_BASE_URL=https://media.gats.vn/s3-video-gats

# --- Thanh toán SePay (mặc định: VietQR + webhook ngân hàng) ---
# API token my.sepay.vn — bắt buộc cho webhook/poll
SEPAY_API_KEY=
# Webhook URL trên SePay (Integrations → Webhooks):
#   https://api.gats.vn/api/payment/sepay/webhook
# Auth: API Key = SEPAY_API_KEY, loại GD: Tiền vào, JSON, bật retry

# Payment Gateway (tùy chọn — chỉ khi SEPAY_PG_ENABLED=true)
SEPAY_PG_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_PG_ENV=production
# FRONTEND_URL nên để learner site trước, ví dụ:
# FRONTEND_URL=https://gats.vn,https://admin.gats.vn

# Fallback STK khi chưa có bank account trong DB
BANK_ACCOUNT_NUMBER=107877010522
BANK_NAME=VietinBank
BANK_ACCOUNT_NAME=VOVANHUYNHANH

# VNPay (chỉ cần nếu bật cổng VNPay; hiện checkout chính là bank_transfer)
VNP_TMN_CODE=
VNP_HASH_SECRET=

# --- FCM / Apple (tùy chọn; để trống = push nằm chờ) ---
# FCM_SERVICE_ACCOUNT_JSON phải là JSON một dòng (hoặc escape đúng).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
APPLE_CLIENT_ID=
