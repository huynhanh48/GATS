{
  "name": "express-gen-ts",
  "version": "1.0.0",
  "scripts": {
    "build": "shx rm -rf dist && npm run lint && tsc --project tsconfig.prod.json && npm run build:copy-static && npm run build:make-db",
    "build:copy-static": "shx mkdir -p dist/public dist/views dist/templates && shx cp -r src/public/* dist/public && shx cp -r src/views/* dist/views && shx cp -r src/templates/* dist/templates",
    "build:make-db": "shx mkdir -p dist/repos/common && shx touch dist/repos/common/database.json && echo \"{}\" > dist/repos/common/database.json",
    "clean-install": "rm -rf ./node_modules && rm -r package-lock.json && npm i",
    "dev:basic": "cross-env DOTENV_CONFIG_PATH=./config/.env.development ts-node ./src/main",
    "dev:watch": "nodemon --exec \"npm run dev:basic\" --watch ./src --ext .ts",
    "dev:worker": "cross-env DOTENV_CONFIG_PATH=./config/.env.development ts-node ./src/workers/worker.main.ts",
    "dev:worker:watch": "nodemon --exec \"npm run dev:worker\" --watch ./src/workers --watch ./src/queues --watch ./src/libs --ext .ts",
    "start:worker": "cross-env DOTENV_CONFIG_PATH=./config/.env.production node -r dotenv/config -r module-alias/register ./dist/workers/worker.main.js",
    "dev": "concurrently \"npm run dev:watch\" \"npm run sync\"",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:generate": "cross-env DOTENV_CONFIG_PATH=./config/.env.development DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres drizzle-kit generate",
    "db:push": "cross-env DOTENV_CONFIG_PATH=./config/.env.development DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres drizzle-kit push",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=./config/.env.development DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres ts-node ./scripts/seed-roles.ts",
    "db:seed:permissions": "cross-env DOTENV_CONFIG_PATH=./config/.env.development DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres ts-node ./scripts/seed-permissions.ts",
    "db:migrate": "cross-env DOTENV_CONFIG_PATH=./config/.env.development DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres drizzle-kit migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "cross-env DOTENV_CONFIG_PATH=./config/.env.production node -r dotenv/config -r module-alias/register ./dist/main.js",
    "sync": "delay 1s && browser-sync start --config bs-config.js",
    "test": "cross-env NODE_ENV=test vitest",
    "type-check": "tsc -b --noEmit"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "_moduleAliases": {
    "@src": "dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@smithy/node-http-handler": "^4.9.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "cache-manager": "^7.2.9",
    "cli-progress": "^3.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jet-env": "^1.1.6",
    "jet-logger": "^2.2.3",
    "jet-paths": "^3.1.1",
    "jet-validators": "^2.3.1",
    "jsonfile": "^6.2.1",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "module-alias": "^2.3.4",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "slugify": "^1.6.9",
    "tspo": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.43",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cli-progress": "^3.11.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonfile": "^6.1.4",
    "@types/mime-types": "^3.0.1",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.3",
    "delay-cli": "^3.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.1",
    "find": "^0.3.0",
    "fs-extra": "^11.3.5",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.3",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
