## Environment ##
NODE_ENV=development

## URL 
DATABASE_URL=
## Postgres ##
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

## Redis ##
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
## Admin Default
ADMIN_DEFAULT_EMAIL=admin@gmail.com 
ADMIN_DEFAULT_PASSWORD=
## Video Storage (S3-compatible - Long Van) ##
VIDEO_STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
S3_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_BUCKET=s3-video-gats
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Browser-facing endpoint (HTTPS). Required when S3_ENDPOINT is http://minio:...
# S3_PUBLIC_ENDPOINT=https://s3-hn1-r1.longvan.net
# S3_PUBLIC_BASE_URL=https://s3-hn1-r1.longvan.net/s3-video-gats

## JWT ##
JWT_SECRET=
JWT_EXPIRES_IN=
## Server ##
PORT=3000
HOST=localhost
## MinIO (thumbnails + documents) ##
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=files-gats
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
# Public URL base (browser-reachable). Local: http://localhost:9010/files-gats
# Prod (nginx /files-gats/ → minio:9000): https://api.gats.vn/files-gats
# MINIO_PUBLIC_BASE_URL=http://localhost:9010/files-gats

## Email ##
EMAIL_USER="anhvvh.sdt.ai@gmail.com"
EMAIL_PASSWORD=

## Frontend URL (comma-separated origins for CORS + credentials) ##
FRONTEND_URL=http://localhost:3001,http://127.0.0.1:3001

## Backend public URL (used in email verify links) ##
APP_URL=http://localhost:3000

VIDEO_WORKER_CONCURRENCY=1
HLS_UPLOAD_CONCURRENCY=16
FFMPEG_X264_PRESET=veryfast

