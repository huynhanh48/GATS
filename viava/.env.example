# Azure OpenAI (required — Viava lifespan crashes without these)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Speech / Transcribe (required for audio URL inputs)
AZURE_OPENAI_TRANSCRIBE_API_KEY=
AZURE_OPENAI_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_DEPLOYMENT=

# Optional web search
TAVILY_API_KEY=

# Qdrant (empty URL = local disk under RAG_WORK_DIR)
QDRANT_URL=
QDRANT_API_KEY=

# GraphRAG / local store root (Docker default)
RAG_WORK_DIR=/app/viava/rag_data
