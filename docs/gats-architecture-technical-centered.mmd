%% Vai trò đi vào đúng kênh truy cập
QT --> ADMIN
SV --> WEB
SV --> MOBILE
GV --> ADMIN

%% Tất cả kênh truy cập đều đi qua cổng bảo mật
ADMIN --> NGINX
MOBILE --> NGINX
WEB --> NGINX

%% Cổng truy cập phân phối yêu cầu đến tầng nghiệp vụ
NGINX --> API
NGINX --> VIAVA

%% Các nghiệp vụ là module của cùng Backend Express, không phải microservice riêng
API --> AUTH
API --> LEARNING
API --> COMMERCE
API --> CONTENT
API --> NOTIFY
API --> VIAVA

%% Dữ liệu và xử lý nền
API --> PG
API --> REDIS
CONTENT --> MINIO
CONTENT --> S3
CONTENT --> REDIS
REDIS --> WORKER
WORKER --> S3

%% Tích hợp bên ngoài
API -.-> GOOGLE
COMMERCE -.-> SEPAY
NOTIFY -.-> MESSAGE
VIAVA -.-> AISERVICE

