# Copy to `.env` on the VPS ONLY (next to docker-compose.yml), then:
#   docker compose -p gats-academy -f docker-compose.yml -f docker-compose.prod.yml up --build -d
#
# Do not use this file for local Docker — use `.env.example` (localhost API).
# Hướng dẫn: docs/docker-build.md
#
# NEXT_PUBLIC_* are baked into the web-app JS at build time.
# Changing them requires `docker compose build --no-cache app` (or up --build).
# BE_API_URL inside the container stays http://localhost:3000 (set in compose).

# --- Google Login (required for Docker + other devices) ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# 2) Authorized JavaScript origins MUST include the exact URL users open:
#      https://gats.vn
#      https://www.gats.vn
#      http://localhost:3005   (local only)
#    Opening http://IP:3005 or a host not listed → Google button fails on other PCs.
# 3) Authorized redirect URIs (GIS popup): https://gats.vn  (and www if used)
# 4) Same Client ID for browser build + BE token verify:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com

NEXT_PUBLIC_API_URL=https://api.gats.vn
APP_URL=https://api.gats.vn
# Chỉ gats.vn (không dùng www). Origin Google Console phải khớp scheme thật:
#   đang HTTP  → thêm http://gats.vn
#   đang HTTPS → thêm https://gats.vn
FRONTEND_URL=https://gats.vn,https://admin.gats.vn,http://localhost:3005,http://localhost:9100

# --- Required production secrets (generate unique values; never commit .env) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gats_academy
JWT_SECRET=
AUTH_COOKIE_DOMAIN=.gats.vn
EMAIL_USER=
EMAIL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=files-gats
# Browser-reachable HTTPS base for media (nginx → minio:9000 /files-gats/).
# Without this, BE stores http://minio:9000/... which browsers cannot open.
MINIO_PUBLIC_BASE_URL=https://api.gats.vn/files-gats
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
# Existing DB only: set once to the baseline already represented by the live
# schema. Leave empty for a fresh DB; remove after first successful deploy.
MIGRATION_BASELINE_THROUGH=

# --- Video storage (required for admin HTTPS upload) ---
# Browser uploads go directly to S3 via presigned URLs. Those URLs MUST be HTTPS
# or Chrome blocks them as mixed-content ("Failed to fetch") on admin.gats.vn.
#
# Option A — LongVan (recommended for prod video):
S3_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_BUCKET=s3-video-gats
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_PUBLIC_BASE_URL=https://s3-hn1-r1.longvan.net/s3-video-gats
#
# Option B — keep in-cluster MinIO for API I/O, but expose a public HTTPS host
# (nginx → minio:9000) and set:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_ENDPOINT=https://media.gats.vn
#   S3_PUBLIC_BASE_URL=https://media.gats.vn/s3-video-gats

# --- Thanh toán SePay (mặc định: VietQR + webhook ngân hàng) ---
# API token my.sepay.vn — bắt buộc cho webhook/poll
SEPAY_API_KEY=
# Webhook URL trên SePay (Integrations → Webhooks):
#   https://api.gats.vn/api/payment/sepay/webhook
# Auth: API Key = SEPAY_API_KEY, loại GD: Tiền vào, JSON, bật retry

# Payment Gateway (tùy chọn — chỉ khi SEPAY_PG_ENABLED=true)
SEPAY_PG_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_PG_ENV=production
# FRONTEND_URL nên để learner site trước, ví dụ:
# FRONTEND_URL=https://gats.vn,https://admin.gats.vn

# Fallback STK khi chưa có bank account trong DB
BANK_ACCOUNT_NUMBER=107877010522
BANK_NAME=VietinBank
BANK_ACCOUNT_NAME=VOVANHUYNHANH

# VNPay (chỉ cần nếu bật cổng VNPay; hiện checkout chính là bank_transfer)
VNP_TMN_CODE=
VNP_HASH_SECRET=

# Viava AI — vendored FastAPI in same app container (:8000)
# Public: https://api.gats.vn/course/...  Internal BE: http://127.0.0.1:8000
VIAVA_COURSE_GEN_URL=http://127.0.0.1:8000
VIAVA_API_KEY=
# v1 path deprecated — BE uses /course/learning-path|exercises|chat

# Azure OpenAI (required for viava-api pm2 process — missing → restart loop)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_TRANSCRIBE_API_KEY=
AZURE_OPENAI_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
TAVILY_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
RAG_WORK_DIR=/app/viava/rag_data

# --- Mobile / FCM / Apple (optional; empty = push stays pending) ---
# FCM_SERVICE_ACCOUNT_JSON must be one-line JSON (or properly escaped).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
MOBILE_FEATURE_FLAGS={"flashcards":true}
MOBILE_MIN_ANDROID_VERSION=1.0.0
MOBILE_MIN_IOS_VERSION=1.0.0
APPLE_CLIENT_ID=
