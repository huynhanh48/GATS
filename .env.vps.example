# Copy to `.env` on the VPS (next to docker-compose.yml), then:
#   docker compose -p gats-academy up --build -d
#
# NEXT_PUBLIC_* are baked into the web-app JS at build time.
# BE_API_URL inside the container stays http://localhost:3000 (set in compose).

NEXT_PUBLIC_GOOGLE_CLIENT_ID=501395717848-vo6vfqup0im33mr0qovsdjffaeh40mcc.apps.googleusercontent.com
NEXT_PUBLIC_API_URL=https://api.gats.vn
APP_URL=https://api.gats.vn
FRONTEND_URL=https://gats.vn,https://www.gats.vn,https://admin.gats.vn,http://localhost:3005,http://localhost:9100

# --- Video storage (required for admin HTTPS upload) ---
# Browser uploads go directly to S3 via presigned URLs. Those URLs MUST be HTTPS
# or Chrome blocks them as mixed-content ("Failed to fetch") on admin.gats.vn.
#
# Option A — LongVan (recommended for prod video):
S3_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_BUCKET=s3-video-gats
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_ENDPOINT=https://s3-hn1-r1.longvan.net
S3_PUBLIC_BASE_URL=https://s3-hn1-r1.longvan.net/s3-video-gats
#
# Option B — keep in-cluster MinIO for API I/O, but expose a public HTTPS host
# (nginx → minio:9000) and set:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_ENDPOINT=https://media.gats.vn
#   S3_PUBLIC_BASE_URL=https://media.gats.vn/s3-video-gats
