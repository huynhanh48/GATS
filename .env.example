# GATS Academy — env tuỳ chọn cho container DEV (docker-compose.yml).
# Copy thành `.env` nếu muốn override:
#   cp .env.example .env
#
# Container dev đã có default chạy được ngay (Postgres/Redis/S3 nằm trong cùng
# container, be/fe/admin chạy dev server). File này chỉ để đổi vài thứ bên ngoài.

# Google Login — cần thì điền (dùng cho cả be verify và fe/admin bundle dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Origin được phép gọi API (CORS + cookie). Mặc định đã khớp 3 cổng 3000/3001/3002.
# FRONTEND_URL=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3001,http://127.0.0.1:3001

# Mật khẩu Postgres trong container dev (mặc định postgres)
# POSTGRES_PASSWORD=postgres
