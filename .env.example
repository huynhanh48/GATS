# GATS Academy — optional overrides for the DEV Docker stack (docker-compose.yml).
# Copy next to docker-compose.yml only if you want to override a default:
#   cp .env.example .env
#
# The dev container already ships working defaults (Postgres + Redis + S3 run
# inside the same container; be/fe/admin run as dev servers). Backend secrets
# live in be/config/.env.development — see be/config/.env.example.
#
# These are the variables docker-compose.yml actually reads:

# Google Sign-In. Leave empty to keep the Google button disabled.
# The same client ID is mapped to admin (NEXT_PUBLIC_*) and fe (PUBLIC_*).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Origin the browser uses to reach the API. Default is http://localhost:3000,
# which is correct when you open fe (3002) / admin (3001) on the same machine.
# PUBLIC_API_URL=http://localhost:3000
