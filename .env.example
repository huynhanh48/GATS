# Local Docker full stack — copy to `.env` next to docker-compose.yml:
#   copy .env.example .env
#
# Defaults already point at localhost. Do NOT use this file on the VPS.
# Production VPS: copy `.env.vps.example` → `.env` (api.gats.vn + secrets).
#
# After changing NEXT_PUBLIC_* you must rebuild:
#   docker compose -p gats-academy up --build -d

NEXT_PUBLIC_API_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3005,http://127.0.0.1:3005,http://localhost:9100,http://127.0.0.1:9100

# Same Web client ID as Google Cloud Console (add http://localhost:3005 origin).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional local overrides (compose has safe-enough defaults for laptop only).
# JWT_SECRET=dev-secret-change-me-please-min-32-characters
